# ---------- Accès
ADMIN_TOKEN=                 # jeton du tableau de bord (généré au hasard à chaque démarrage s'il est vide)
PORT=8080
DB_PATH=data/v2.db

# ---------- Simulation
MM_ASSETS=btc
MM_SIZE=10
MM_CANDLE_SECONDS=5
MM_REBATE=0.2
MM_REFILL=true
MM_EVOLVE_EVERY_WINDOWS=12   # ≈ une heure (BTC seul : un marché toutes les 5 minutes)

# ---------- Production (argent réel) — désactivée par défaut
MM_LIVE=false
MM_LIVE_SIZE=5
MM_LIVE_MAX_STOCK=10
MM_LIVE_MAX_EXPOSURE=10
MM_LIVE_MAX_DAILY_LOSS=20
MM_LIVE_MIN_MARKETS=300
MM_LIVE_MIN_TSTAT=2
MM_LIVE_DESK=
ORDER_LIFETIME_SECONDS=120   # durée de vie d'un ordre si le moteur se tait (minimum Polymarket)
POLYMARKET_PRIVATE_KEY=      # utilisez un portefeuille et une clé API DÉDIÉS : le heartbeat annule tous les ordres de la clé
POLYMARKET_FUNDER_ADDRESS=
POLYMARKET_SIGNATURE_TYPE=1
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# ---------- Alertes (facultatif)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
