# ---------- Sécurité (obligatoire une fois déployé)
CRON_SECRET=            # protège /api/cron/tick ; Vercel Cron l'envoie automatiquement
ADMIN_TOKEN=            # jeton demandé par le tableau de bord pour les commandes

# ---------- Stockage (un des deux ; Blob est connecté automatiquement par Vercel)
# BLOB_READ_WRITE_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ---------- Démo (argent fictif)
DEMO_BANKROLL=1000
KELLY_FRACTION=0.25     # fraction du critère de Kelly
MAX_STAKE_PCT=0.03      # mise maximale par trade, en part du capital
CHAMPION_MIN_TRADES=40  # preuves exigées avant qu'une stratégie pilote le compte
CHAMPION_Z=2            # … et fiabilité statistique minimale (t)
EVOLVE_EVERY_WINDOWS=96
FILL_CONFIRM_MS=1500    # délai avant de vérifier qu'un ordre fictif aurait été exécuté
MAX_SLIPPAGE=0.01
MAX_SPREAD=0.04
LAST_ENTRY_SECONDS=240  # plus aucune entrée dans la dernière minute
TICK_LOOP_SECONDS=285   # durée d'une session du moteur (la fonction Vercel est limitée à 300 s)

# ---------- Temps réel (flux WebSocket : prix Binance + carnet d'ordres Polymarket)
REALTIME=true           # false = interrogation périodique toutes les TICK_INTERVAL_SECONDS
STREAM_EVAL_MS=200      # une décision toutes les 200 ms
STREAM_CONFIRM_MS=500   # temps de trajet simulé d'un ordre fictif
PERSIST_SECONDS=0       # 0 = automatique (30 s ; fin de session seulement sur Vercel Blob)
TICK_INTERVAL_SECONDS=10

# ---------- Production (argent réel) — désactivé par défaut
LIVE_TRADING=false
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=     # adresse du portefeuille Polymarket (proxy) qui détient les USDC
POLYMARKET_SIGNATURE_TYPE=1    # 1 = compte e-mail/Magic, 2 = portefeuille navigateur, 0 = EOA direct
LIVE_STAKE_USD=5
LIVE_MAX_DAILY_LOSS=25
LIVE_MIN_TRADES=150
LIVE_MIN_TSTAT=3
LIVE_MAX_SLIPPAGE=0.02

# ---------- Tenue de marché en argent réel — désactivée par défaut
MM_LIVE=false
MM_LIVE_SIZE=5              # parts par ordre (minimum Polymarket : 5)
MM_LIVE_MAX_STOCK=10        # parts maximum détenues d'un côté
MM_LIVE_MAX_EXPOSURE=10     # perte maximale ($) sur un marché qui finit du mauvais côté
MM_LIVE_MAX_DAILY_LOSS=20   # arrêt pour la journée au-delà
MM_LIVE_MIN_MARKETS=300     # le bureau copié doit d'abord avoir fait ses preuves en simulation
MM_LIVE_MIN_TSTAT=2
MM_LIVE_DESK=               # vide = le bureau en tête
